// Déploiement sur Cloudflare Workers (gratuit jusqu'à 100 000 requêtes / jour).
// Les pages pré-générées sont servies directement par le CDN ; seul /api/contact exécute le worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fc-menuiserie",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
  // Secrets à définir une fois (jamais dans ce fichier) :
  //   npx wrangler secret put NUXT_RESEND_API_KEY
  //   npx wrangler secret put NUXT_CONTACT_TO      (facultatif, sinon l'e-mail de shared/business.ts)
  //   npx wrangler secret put NUXT_CONTACT_FROM    (adresse d'un domaine vérifié chez Resend)
}
